# ---- 构建产物 ----
/build/*
!/build/build.sh

# ---- 工具链：约 900 MB，且包含签名密钥，不应入库 ----
build/toolchain/

# ---- 从真机提取的备份：含厂商 APK 与设备信息，不适合公开 ----
/backup/

# ---- 从真机导出的系统属性：调试残留，非项目文件 ----
*.prop

# ---- 内部过程文档（含本地实验细节，默认不公开）----
/docs/电视儿童看护弹题方案.md
/docs/提案-英语升级与界面隐藏.md

# ---- 内容创作稿，不属于项目文档 ----
/docs/公众号文章-*.md

# ---- 签名与本地环境 ----
*.jks
*.keystore
.env
.workbuddy/

# ---- IDE / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
